# Google PageSpeed Insights API key (Google Cloud Console → enable "PageSpeed Insights API").
# Server-side only. Without it Google's shared quota is usually exhausted and only our quick
# checks show.
PSI_API_KEY=

# --- Email: report is sent with nodemailer over SMTP ---
SMTP_HOST=mail.sterlixit.co.uk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@sterlixit.co.uk
SMTP_PASSWORD=
EMAIL_FROM="Sterlixit <hello@sterlixit.co.uk>"
EMAIL_REPLY_TO=hello@sterlixit.co.uk

# --- Zoho CRM: every lead is created in this module (or gets a Note if the email exists) ---
# Same self-client credentials as the sterlixit website. Scope needed: ZohoCRM.modules.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_LEAD_MODULE=Leads

# Local backup of every lead (JSON). Keeps staff mode, re-send and CSV export working and
# means nothing is lost if Zoho is unreachable.
LEADS_FILE=data/leads.json
# Recent scans: the same site scanned again comes back instantly (24 h with scores, 1 h if
# PageSpeed failed) and this survives restarts.
SCANS_FILE=data/scans.json

# PIN for staff mode (long-press the logo for 1.5 s). Staff mode is disabled if empty.
STAFF_PIN=

# "Book a free strategy call" page. UTM tags are added automatically:
#   utm_source=UTM_SOURCE, utm_medium=qr|kiosk|email, utm_campaign=UTM_CAMPAIGN (or the event
#   name as a slug), utm_content=thank-you-qr|thank-you-button|report-cta|report-footer
BOOKING_URL=https://www.sterlixit.co.uk/book-free-strategy-call
UTM_SOURCE=website-health-check
UTM_CAMPAIGN=
PRIVACY_URL=https://www.sterlixit.co.uk/legal/privacy-policy

# Saved on each lead as Lead Source = "Stand – <EVENT_NAME>" and as a Zoho tag.
EVENT_NAME="Business Show 2026"

# Optional: secret for signing scan snapshots (derived from the other secrets if empty).
APP_SECRET=

# Manifest orientation for the installed kiosk app: portrait (default) or any.
KIOSK_ORIENTATION=portrait

# --- StaffMain showcase (/staffmain) ---
STAFFMAIN_URL=https://staffmain.sterlixit.co.uk
# Booking page for StaffMain demos (defaults to BOOKING_URL)
STAFFMAIN_BOOKING_URL=
# "Create your password" link used in the account-ready email (staff can change it per lead)
STAFFMAIN_SIGNUP_URL=https://staffmain.sterlixit.co.uk
STAFFMAIN_LEADS_FILE=data/staffmain-leads.json
STAFFMAIN_UTM_SOURCE=staffmain-showcase

# Optional custom Zoho Lead fields (API names). Leave blank to keep the answers in the
# description, tags and notes, which works with a standard Zoho set-up.
ZOHO_FIELD_PRODUCT=
ZOHO_FIELD_INDUSTRY=
ZOHO_FIELD_EMPLOYEES=
ZOHO_FIELD_SITES=
ZOHO_FIELD_MOST_TIME=
ZOHO_FIELD_CURRENT_SOLUTION=
ZOHO_FIELD_TIMEFRAME=

# --- LetFlows showcase (/letflows) ---
LETFLOWS_URL=https://letflows.com
# Booking page for LetFlows demos (defaults to BOOKING_URL)
LETFLOWS_BOOKING_URL=
# "Create your password" link used in the account-ready email (staff can change it per lead)
LETFLOWS_SIGNUP_URL=https://app.letflows.com
LETFLOWS_LEADS_FILE=data/letflows-leads.json
LETFLOWS_UTM_SOURCE=letflows-showcase
# Optional custom Zoho Lead fields for LetFlows answers (API names)
ZOHO_FIELD_ROLE=
ZOHO_FIELD_PROPERTIES=
ZOHO_FIELD_HEADACHES=
ZOHO_FIELD_MTD=

# --- General enquiry (/enquiry) ---
ENQUIRY_LEADS_FILE=data/enquiry-leads.json
ENQUIRY_UTM_SOURCE=general-enquiry
ZOHO_FIELD_SERVICES=
ZOHO_FIELD_BUDGET=
ZOHO_FIELD_CONTACT_PREF=
ZOHO_FIELD_FILLED_BY=
